<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/jarvis_accento</item>
        <item name="colorPrimaryDark">@color/jarvis_primary_dark</item>
        <item name="colorAccent">@color/jarvis_accento</item>
        <item name="colorOnPrimary">@color/jarvis_su_accento</item>
        <item name="android:windowBackground">@color/jarvis_fondo</item>
        <item name="android:textColorPrimary">@color/jarvis_testo</item>
        <item name="android:textColorSecondary">@color/jarvis_testo_tenue</item>
        <item name="colorControlNormal">@color/jarvis_testo_tenue</item>
        <item name="colorControlActivated">@color/jarvis_accento</item>
        <item name="android:statusBarColor">@color/jarvis_fondo</item>
        <item name="android:navigationBarColor">@color/jarvis_fondo</item>
        <item name="android:windowLightStatusBar">@bool/barre_chiare</item>
        <item name="android:windowLightNavigationBar">@bool/barre_chiare</item>
        <item name="colorSurface">@color/jarvis_rialzo</item>
        <item name="colorOnSurface">@color/jarvis_testo</item>
        <item name="android:colorBackground">@color/jarvis_fondo</item>
        <item name="snackbarStyle">@style/Jarvis.Snackbar</item>
        <item name="popupMenuStyle">@style/Jarvis.Popup</item>
    </style>

    <style name="Jarvis.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/bg_snackbar</item>
    </style>

    <style name="Jarvis.Popup" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="Jarvis.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/jarvis_rialzo</item>
        <item name="cardCornerRadius">@dimen/raggio_scheda</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/jarvis_linea</item>
        <item name="strokeWidth">@dimen/bordo</item>
        <item name="contentPadding">@dimen/spazio_2</item>
    </style>

    <!-- 0.2.0: titolo con le grazie delle schede degli agenti. -->
    <style name="Jarvis.TitoloScheda" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textSize">@dimen/testo_titolo_scheda</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Jarvis.Corpo" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textSize">@dimen/testo_corpo</item>
    </style>

    <style name="Jarvis.Piccolo" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_testo_tenue</item>
        <item name="android:textSize">@dimen/testo_piccolo</item>
    </style>

    <!-- Pulsante tondo con sola icona (impostazioni, monitor, indietro): 48 dp di tocco. -->
    <style name="Jarvis.Icona" parent="">
        <item name="android:layout_width">@dimen/tocco_minimo</item>
        <item name="android:layout_height">@dimen/tocco_minimo</item>
        <item name="android:background">@drawable/bg_icona</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/jarvis_testo</item>
    </style>

    <!-- Titoli e spie in monospazio, come il Command Center. Quello di sistema:
         niente font esterni. -->
    <style name="JarvisSectionTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/jarvis_testo_tenue</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Jarvis.Titolo" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Jarvis.Spia" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- «Impronta», «Whisper»...: colonna fissa, così i pallini stanno in fila. -->
    <style name="Jarvis.Etichetta" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_testo_tenue</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Jarvis.Valore" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Jarvis.Nota" parent="">
        <item name="android:textColor">@color/jarvis_testo_tenue</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Jarvis.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/jarvis_accento</item>
        <item name="cornerRadius">@dimen/raggio_pillola</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_su_accento</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Bordo e testo in accento: col bordo grigio (#5A5A5A su #1F1F1F) il
         tasto quasi spariva sul fondo scuro (prova su telefono reale, 26/09/2026). -->
    <style name="Jarvis.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/jarvis_accento</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/raggio_pillola</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_accento</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Gli interruttori delle Impostazioni: etichetta a sinistra, interruttore
         a destra; verde acceso, grigio spento. -->
    <style name="Jarvis.Interruttore" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbTint">@color/interruttore_pollice</item>
        <item name="trackTint">@color/interruttore_binario</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Jarvis.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/jarvis_danger</item>
        <item name="cornerRadius">@dimen/raggio_pillola</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/jarvis_su_accento</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Jarvis.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/jarvis_testo</item>
        <item name="android:textColorHint">@color/jarvis_testo_tenue</item>
    </style>
</resources>
