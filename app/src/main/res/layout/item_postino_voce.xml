<?xml version="1.0" encoding="utf-8"?>
<!-- Una mail numerata: numero, mittente, casella, oggetto, anteprima, categoria, azione proposta, stato. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheda"
    style="@style/Jarvis.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/postino_spazio_1"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:checkedIconTint="@color/jarvis_accento"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/numero"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/jarvis_accento"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/da"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/jarvis_testo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/casella"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/jarvis_testo_tenue"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/urgenza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/postino_spazio_1"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/oggetto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/postino_spazio_mezzo"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/jarvis_testo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/anteprima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/jarvis_testo_tenue"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/postino_spazio_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/postino_pillola"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textColor="@color/jarvis_testo_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/proposta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/postino_spazio_1"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/jarvis_accento"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inviaBozza"
                style="@style/Jarvis.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Invia"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/stato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/postino_spazio_mezzo"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
