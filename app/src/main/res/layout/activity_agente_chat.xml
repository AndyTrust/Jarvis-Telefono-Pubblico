<?xml version="1.0" encoding="utf-8"?>
<!-- La chat a tutto schermo di un agente (0.7.1, layout approvato da Boss il 09/10), la stessa per tutti:
     JBoss (dall'avatar in Home), Ricercatore, Social, Mani, Scrittore. Il Postino ha la sua pagina.
     <   (avatar)  Nome agente                     ⚙
         ● pronto
     ────────────────────────────────────────────────
       una riga onesta su cosa sa fare oggi
       Tu: …
       Agente: risposta
       ● In corso: sto cercando…            ← riga di stato del lavoro (vista_comando)
       ┌ Serve il tuo sì ─────────────────┐
       │           [Annulla] [Invia]      │ ← box del sì, nel filo
       └──────────────────────────────────┘
       (il filo scorre, l'ultimo in basso)
     ────────────────────────────────────────────────
     [ Scrivi a <agente>: «…», «…»     ] (🎤) (📞) (↑)   ← barra_agente.xml
     Niente storico, niente filtri, niente ricerca: solo il filo di questo agente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_fondo"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/spazio_2"
    android:paddingTop="@dimen/spazio_1"
    android:paddingEnd="@dimen/spazio_2"
    android:paddingBottom="@dimen/spazio_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/tasto_indietro"
            style="@style/Jarvis.Icona"
            android:contentDescription="@string/indietro"
            android:src="@drawable/ic_indietro" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spazio_mezzo">

            <View
                android:id="@+id/anello"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spazio_1"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nome"
                style="@style/Jarvis.TitoloScheda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pallino"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/spia" />

                <TextView
                    android:id="@+id/stato"
                    style="@style/Jarvis.Piccolo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spazio_1"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- 2026-10-10: la missione dell'agente, una riga. -->
            <TextView
                android:id="@+id/missione"
                style="@style/Jarvis.Piccolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/jarvis_testo_tenue" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/tasto_impostazioni_agente"
            style="@style/Jarvis.Icona"
            android:contentDescription="@string/chat_impostazioni_agente"
            android:src="@drawable/ic_impostazioni"
            android:tooltipText="@string/chat_impostazioni_agente" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/bordo"
        android:layout_marginTop="@dimen/spazio_1"
        android:background="@color/jarvis_linea" />

    <!-- Il filo: avviso, scambi, riga di stato del lavoro e box del sì, tutto nello stesso scorrimento. -->
    <ScrollView
        android:id="@+id/scorri_cronologia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spazio_1">

            <TextView
                android:id="@+id/avviso"
                style="@style/Jarvis.Piccolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spazio_1"
                android:background="@drawable/bg_frase_boss"
                android:padding="@dimen/spazio_2"
                android:textColor="@color/jarvis_testo" />

            <LinearLayout
                android:id="@+id/lista_cronologia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include layout="@layout/vista_comando" />
        </LinearLayout>
    </ScrollView>

    <!-- In basso: la barra degli agenti, uguale in tutte le chat (layout barra_agente). -->
    <include layout="@layout/barra_agente" />
</LinearLayout>
