<?xml version="1.0" encoding="utf-8"?>
<!-- Una cella della riga degli avatar in Home (0.7.1): avatar con anello e nome sotto; per il Postino
     anche lo stato breve («12 nuove · 10:42»). Un tocco apre la chat dell'agente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spazio_1"
    android:background="@drawable/bg_riga"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spazio_mezzo">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <View
            android:id="@+id/anello"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/nome"
        style="@style/Jarvis.Piccolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxWidth="80dp"
        android:maxLines="1"
        android:textColor="@color/jarvis_testo" />

    <TextView
        android:id="@+id/sotto"
        style="@style/Jarvis.Piccolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:breakStrategy="simple"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxWidth="96dp"
        android:maxLines="2"
        android:visibility="gone" />
</LinearLayout>
